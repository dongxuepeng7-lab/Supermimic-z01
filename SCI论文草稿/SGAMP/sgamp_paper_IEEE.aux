\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Phase-conditioned discriminator (contribution 2). A gait phase $\phi _t$ driven by foot-contact events is encoded as $(\cos \phi _t,\sin \phi _t)$ and concatenated to the discriminator input, so the discriminator learns phase-consistent style and suppresses within-cycle fluctuation.}}{3}{}\protected@file@percent }
\newlabel{fig:phase}{{3}{3}{}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}Baselines, Metrics, and Ablations}{3}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Benchmarking and ablation across simulated protocols (5 random seeds; mean $\pm $ std.\ in MuJoCo). All methods achieve 100\% survival under nominal flat walking. Planar touchdown is the stance percentage free of ankle inversion/eversion tilting.}}{4}{}\protected@file@percent }
\newlabel{tab:comparison}{{I}{4}{}{table.1}{}}
